# Neon pooled connection string (Neon console > Connect > Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Auth (Neon console > Auth > Configuration): the branch's Auth URL
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth"
# Session cookie signing key, 32+ chars: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
